**/build/*
!**/build/*.ino.hex
!**/build/*.ino.eep
**/.*/*
# private files with real secrets, e.g. data/totp.local.txt (the totp tool
# refuses *.local.* files in header mode)
**/*.local.*

# Arduino IDE export puts these files next to the sketch too, the copies
# of the export hooks in build/ are the ones to commit
/*/*.hex
/*/*.lst
